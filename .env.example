# Copy to .env and adjust. Everything here is optional.

# Sign session cookies. If unset, a random key is generated and saved in instance/secret_key.
# SECRET_KEY=change-me

# First admin account (only used when the database has no admin yet).
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123

# Brand name shown in the UI
# APP_NAME=DentScan

# Damage model weights, and the COCO model used to check photos contain a vehicle ("" disables it)
# DAMAGE_WEIGHTS=models/best.pt
# VEHICLE_WEIGHTS=yolov8n.pt

# DETECTOR_MODE=demo   -> simulated detections, for trying the UI without PyTorch installed

# HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=1
# MAX_UPLOAD_MB=40
